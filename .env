# ══════════════════════════════════════════════════════════
# CodeSentinel — Variables de entorno
# Copia este fichero a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio.
# ══════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# Symfony
# ──────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=change_me_to_a_random_32_char_string
APP_PORT=8088

# ──────────────────────────────────────────────
# PHP
# ──────────────────────────────────────────────
PHP_VERSION=8.4

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_DB=codesentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_PORT=5434

# DATABASE_URL se construye en docker-compose a partir de las vars anteriores.
# Para usar fuera de Docker (ej: bin/console desde host):
DATABASE_URL="postgresql://sentinel:sentinel_secret@localhost:5434/codesentinel?serverVersion=16&charset=utf8"

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_PORT=6380
REDIS_URL="redis://:redis_secret@localhost:6380"

# Symfony Messenger — transport para jobs async
MESSENGER_TRANSPORT_DSN="redis://:redis_secret@localhost:6380/messages"

# ──────────────────────────────────────────────
# Anthropic / Claude API
# ──────────────────────────────────────────────
# Genera tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# Límites de la API
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_MAX_DIFF_CHARS=80000

# ──────────────────────────────────────────────
# GitHub App
# ──────────────────────────────────────────────
# Crea tu GitHub App en: https://github.com/settings/apps/new
# Permisos necesarios: Pull Requests (read/write), Contents (read)
GITHUB_APP_ID=000000
GITHUB_APP_NAME=codesentinel-bot

# Ruta al fichero .pem de la clave privada de la GitHub App
# Este fichero NUNCA va al repositorio
GITHUB_PRIVATE_KEY_FILE=./docker/secrets/github_app.pem
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_private_key

# Secret del webhook (ponlo también en la config de la GitHub App)
GITHUB_WEBHOOK_SECRET=webhook_secret_change_me

# ──────────────────────────────────────────────
# Análisis de código
# ──────────────────────────────────────────────
# Número máximo de ficheros del PR a analizar
MAX_FILES_PER_PR=20
# Extensiones de fichero a analizar (separadas por coma)
ANALYZED_EXTENSIONS=php,js,ts,vue,twig,yaml,yml
# Umbral mínimo de severidad para publicar comentario: low|medium|high|critical
MIN_SEVERITY_TO_COMMENT=medium

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6380/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
